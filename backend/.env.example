# 开发环境示例配置。
# 生产部署请使用项目根目录的 .env.production.example，并执行：
#   docker compose -f docker-compose.prod.yml --profile tools run --rm migrate
#   docker compose -f docker-compose.prod.yml up -d
# 注意：生产环境（APP_ENV=production）禁止 APP_DEBUG=true、AUTO_CREATE_TABLES=true、mock LLM/Embedding。

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=True
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=True

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_USERNAMES=admin
# Prometheus 采集 /api/system/metrics 用的静态 Bearer 令牌。
# 留空则该端点仅管理员会话可读；任何情况下都不对匿名开放。
METRICS_TOKEN=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DB=llmXM
# Optional full SQLAlchemy URL override, useful for tests/migrations.
DATABASE_URL=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT=60

EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3

RERANKER_PROVIDER=auto
RERANKER_MODEL_PATH=
RERANKER_BATCH_SIZE=8

ORCHESTRATION_STRATEGY=linear
ORCHESTRATION_ENGINE=native
ORCHESTRATION_BACKEND=thread
REDIS_URL=redis://127.0.0.1:6379/0

RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ---- 限流（slowapi，可选）----
RATE_LIMIT_GENERAL=100/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_LOGIN=5/minute

# ---- 备份保留天数（可选）----
BACKUP_KEEP_DAYS=7
