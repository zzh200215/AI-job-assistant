# 开发环境示例配置。
# 生产部署请使用项目根目录的 .env.production.example，并执行：
#   docker compose -f docker-compose.prod.yml --profile tools run --rm migrate
#   docker compose -f docker-compose.prod.yml up -d
# 注意：生产环境（APP_ENV=production）禁止 APP_DEBUG=true、AUTO_CREATE_TABLES=true、mock LLM/Embedding。

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=True
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=True

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_USERNAMES=admin
# Prometheus 采集 /api/system/metrics 用的静态 Bearer 令牌。
# 留空则该端点仅管理员会话可读；任何情况下都不对匿名开放。
METRICS_TOKEN=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DB=llmXM
# Optional full SQLAlchemy URL override, useful for tests/migrations.
DATABASE_URL=
# SQLAlchemy 连接池（只对 MySQL 生效；内存 sqlite 走 StaticPool，不接这三项）。
# 不设时跑的是框架默认 5 + 10 = 15 根、排队 30 秒；每条面试 WebSocket 会独占一根，
# 所以这三个数与 WS_MAX_LIVE_INTERVIEWS 是绑在一起的，改一处要看另一处。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=120

EMBEDDING_PROVIDER=mock
# 换供应商时必须显式钉住这两行的情形：`LLM_PROVIDER` 与 `EMBEDDING_PROVIDER` 不是同一家。
# 代码里是 `EMBEDDING_API_KEY or LLM_API_KEY`、`EMBEDDING_BASE_URL or LLM_BASE_URL`
# （`services/embedding_service.py:317/333/337`），留空就等于让向量化跟着 LLM 去另一家找
# `text-embedding-v3`——那家通常没有向量模型，RAG 会静默挂掉。生产启动会直接拒绝这种组合。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3

RERANKER_PROVIDER=auto
RERANKER_MODEL_PATH=
RERANKER_BATCH_SIZE=8

ORCHESTRATION_STRATEGY=linear
ORCHESTRATION_ENGINE=native
ORCHESTRATION_BACKEND=thread
REDIS_URL=redis://127.0.0.1:6379/0

RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ---- 限流（slowapi，可选）----
RATE_LIMIT_GENERAL=100/minute
RATE_LIMIT_AUTH=20/minute
# 每个用户每分钟的真实模型调用额度（E28）。只对非 mock provider 生效；0 = 关闭。
# 默认 30 ≈ 一分钟内三个完整深度分析（实测：一次 linear 编排 12 个 agent、13 个 chat 调用点）。
LLM_CALLS_PER_USER_PER_MINUTE=30
RATE_LIMIT_LOGIN=5/minute

# ---- 备份保留天数（可选）----
BACKUP_KEEP_DAYS=7
