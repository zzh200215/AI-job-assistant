# ============================================================
# 生产环境示例配置
# 复制本文件为 .env 并填充真实值后再启动 docker-compose.prod.yml
# ============================================================

# ---- 强制生产模式（不可修改） ----
APP_ENV=production
APP_DEBUG=false
AUTO_CREATE_TABLES=false

# ---- MySQL ----
MYSQL_PASSWORD=Change-This-To-A-Strong-Password-2026
MYSQL_DB=llmXM

# ---- JWT ----
JWT_SECRET=Your-Random-String-At-Least-32-Characters-Long

# ---- 管理员（逗号分隔） ----
ADMIN_USERNAMES=admin

# ---- LLM（生产禁止使用 mock） ----
# 支持 openai / qwen / local / dashscope 等，需与后端实现匹配
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
# 生产环境禁止将 LLM_FALLBACK_MODEL 设为 mock
LLM_FALLBACK_MODEL=
# 生产环境默认 false，禁止在 fallback 链路中回退到 mock
LLM_ALLOW_MOCK_FALLBACK=false

# ---- Embedding（生产禁止使用 mock） ----
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=2

# ---- 日志 ----
# 设为 true 时输出 JSON 结构化日志，便于对接 Loki / ELK
STRUCTURED_LOGS=false

# ---- 限流（slowapi）----
# 空值表示使用代码默认值；内存存储，若配置了 REDIS_URL 则自动使用 Redis
RATE_LIMIT_GENERAL=100/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_LOGIN=5/minute

# ---- 备份保留天数 ----
BACKUP_KEEP_DAYS=7

# ---- Grafana（启用 monitoring profile 时必填）----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Change-This-Grafana-Password-2026

# ---- Reranker（可选） ----
RERANKER_PROVIDER=auto

# ---- 编排（可选） ----
ORCHESTRATION_STRATEGY=linear
ORCHESTRATION_ENGINE=native
ORCHESTRATION_BACKEND=thread

# ---- RAG（可选） ----
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
